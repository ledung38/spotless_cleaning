{
  "buildCommand": "next build",
  "framework": "nextjs",
  "installCommand": "yarn install",
  "env": {
    "NEXT_PUBLIC_SITE_URL": "@next-public-site-url"
  },
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=86400"
        }
      ]
    },
    {
      "source": "/_next/static/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "functions": {
    "api/send-email.js": {
      "memory": 1024,
      "maxDuration": 30
    }
  }
}
